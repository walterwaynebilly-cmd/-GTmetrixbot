# Get this from @BotFather on Telegram
BOT_TOKEN=

# Get a free key from https://console.cloud.google.com/apis/credentials
# (enable "PageSpeed Insights API" on the project first)
PSI_API_KEY=

# Set automatically by Railway — do not set manually in production.
# For local testing you can leave this blank; the bot will fall back to polling.
WEBHOOK_URL=

# Railway injects PORT automatically. Only needed for local runs.
PORT=3000
